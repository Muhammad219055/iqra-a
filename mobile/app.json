{
  "expo": {
    "name": "Quran Tutor",
    "slug": "quran-tutor",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mki15.qurantutor",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Quran Tutor requires microphone access to listen to your recitation and provide live teacher feedback."
      },
      "appleTeamId": "GUY9JCSF5U"
    },
    "android": {
      "package": "com.muhammad.qurantutor",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9EF",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Quran Tutor requires microphone access to listen to your recitation and provide live teacher feedback."
        }
      ],
      "expo-asset"
    ]
  }
}
